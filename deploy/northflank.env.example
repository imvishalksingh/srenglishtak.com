# Runtime variables only. Replace placeholders using the SAME production secrets as Render.
# Never commit a filled-in copy or add these values as Docker build arguments.
SPRING_PROFILES_ACTIVE=northflank
PORT=8080
APP_TIMEZONE=Asia/Kolkata
DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USER=YOUR_EXISTING_DATABASE_USER
DB_PASSWORD=YOUR_EXISTING_RAW_DATABASE_PASSWORD
DB_POOL_SIZE=5
DB_MIN_IDLE=1
SUPABASE_URL=https://YOUR_EXISTING_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_EXISTING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_EXISTING_SERVICE_ROLE_KEY
ALLOWED_ORIGINS=https://srenglishtakadmin.netlify.app,https://YOUR_PUBLIC_WEBSITE
ALLOW_ADMIN_REGISTRATION=false
API_DOCS_ENABLED=false
LOCAL_JWT_VERIFICATION=true
AUTH_CACHE_SECONDS=30
PASSWORD_RESET_REDIRECT_URL=https://YOUR_REAL_FRONTEND/reset-password
# Verify the actual ingress addresses/range; never copy a guessed private-network range.
TRUSTED_PROXY_IPS=
PAYMENTS_MODE=live
GOOGLE_PLAY_PACKAGE_NAME=com.srenglishtak.app
# Add the ORIGINAL JSON as a Northflank runtime secret; not this placeholder text.
GOOGLE_PLAY_CREDENTIALS_JSON=YOUR_EXISTING_SERVICE_ACCOUNT_JSON
GOOGLE_PLAY_CREDENTIALS_FILE=
PAYMENT_TOKEN_ENCRYPTION_KEY=YOUR_EXISTING_UNCHANGED_ENCRYPTION_KEY
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=YOUR_EXISTING_PROJECT_NUMBER
PLAY_INTEGRITY_CERTIFICATE_SHA256=YOUR_EXISTING_PLAY_SIGNING_SHA256
READER_MINIMUM_VERSION_CODE=10
# Reader inherits the Google Play credential source unless explicitly overridden.
# If using a distinct account, set BOTH reader source variables, leaving unused one empty.
# PLAY_INTEGRITY_CREDENTIALS_JSON=YOUR_READER_SERVICE_ACCOUNT_JSON
# PLAY_INTEGRITY_CREDENTIALS_FILE=
# Optional website provider: copy only if previously enabled, retaining the same mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
