# JDBC URL: Supabase direct/session pooler connection. Prefer session pooling for this Java service.
DB_URL=jdbc:postgresql://YOUR_HOST:5432/postgres?sslmode=verify-full
DB_USER=postgres
DB_PASSWORD=replace-me
DB_POOL_SIZE=10
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://YOUR_ADMIN_DOMAIN
PORT=8080
APP_TIMEZONE=Asia/Kolkata
# Google provider and Flutter web client ID must be configured in Supabase Auth.
# Existing admins are read from profiles.role. Public admin signup stays disabled.
ALLOW_ADMIN_REGISTRATION=false
ADMIN_REGISTRATION_SECRET=
PASSWORD_RESET_REDIRECT_URL=https://YOUR_FRONTEND/reset-password
# Exact proxy IPs or verified ingress CIDRs only. Never trust all networks.
TRUSTED_PROXY_IPS=

# Local JWT validation uses this project's public JWKS for ES256/RS256 tokens.
# Legacy server-verified identities may be cached briefly; database roles remain fresh.
LOCAL_JWT_VERIFICATION=true
AUTH_CACHE_SECONDS=30
API_DOCS_ENABLED=false

# disabled, test, or live. Provider credentials are optional while disabled.
PAYMENTS_MODE=disabled
GOOGLE_PLAY_PACKAGE_NAME=com.srenglishtak.app
GOOGLE_PLAY_CREDENTIALS_FILE=
# Alternative: runtime secret containing the original service-account JSON. Set only one source.
GOOGLE_PLAY_CREDENTIALS_JSON=
# Base64 of 32 random bytes; keep stable and backed up (AES-GCM encryption).
PAYMENT_TOKEN_ENCRYPTION_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Protected reader: Google Play app-signing certificate (not the upload/debug certificate).
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
PLAY_INTEGRITY_CERTIFICATE_SHA256=
# Optional when using the same service account as Google Play verification.
# PLAY_INTEGRITY_CREDENTIALS_FILE=/etc/secrets/google-play-service-account.json
READER_MINIMUM_VERSION_CODE=10
